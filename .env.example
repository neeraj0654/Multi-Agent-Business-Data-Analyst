# ─────────────────────────────────────────────
#  Multi-Agent Business Data Analyst — Config
# ─────────────────────────────────────────────

# LLM Provider: "ollama" | "openai" | "gemini"
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=business_db
POSTGRES_USER=analyst
POSTGRES_PASSWORD=analyst_secret

# App
LOG_LEVEL=INFO
CHARTS_DIR=/app/charts
